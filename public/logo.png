<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" width="400" height="400">
  <!-- Outer Light Gray Circle Frame -->
  <circle cx="200" cy="200" r="185" fill="#FFFFFF" stroke="#E2E8F0" stroke-width="12"/>
  
  <!-- Subtle inner background -->
  <circle cx="200" cy="200" r="170" fill="#FAFAFA"/>
  
  <!-- Chetak Running Horse Silhouette Emblem (Rich Crimson Red) -->
  <g transform="translate(115, 65) scale(0.85)">
    <path d="M 120 20 C 110 10, 95 5, 80 12 C 70 16, 65 25, 55 30 C 45 35, 30 30, 20 40 C 10 50, 15 65, 25 75 C 35 85, 45 80, 50 95 C 55 110, 40 125, 45 140 C 50 155, 65 150, 75 135 C 85 120, 95 125, 105 140 C 115 155, 130 150, 125 130 C 120 110, 135 100, 145 90 C 155 80, 165 65, 155 50 C 150 42, 140 38, 130 35 C 135 25, 130 15, 120 20 Z" fill="#C8232C"/>
  </g>

  <!-- Red Header Box for CHETAK FASHION -->
  <rect x="50" y="215" width="300" height="52" rx="8" fill="#C8232C"/>
  <text x="200" y="251" font-family="'Inter', Arial, sans-serif" font-weight="900" font-size="25" fill="#FFFFFF" text-anchor="middle" letter-spacing="2">CHETAK FASHION</text>
  
  <!-- Registered Trademark Circle -->
  <text x="338" y="228" font-family="sans-serif" font-weight="bold" font-size="12" fill="#C8232C">®</text>

  <!-- Tagline text below box -->
  <text x="200" y="295" font-family="'Inter', Arial, sans-serif" font-weight="700" font-size="14" fill="#1E1E1E" text-anchor="middle" letter-spacing="0.5">Mfg. of Exclusive Dress Material</text>
</svg>
